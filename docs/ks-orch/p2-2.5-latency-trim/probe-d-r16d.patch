+/// D-R16d (lane 2.5 probe, uncommitted): a helper thread that does what the
+/// deferred wake of cut D12 does, one wait return, a `SetWaitableTimer` and
+/// a wait that leaves the posted bit out, then at its 5 ms timer pumps
+/// everything and goes idle. Each sample posts one message to it and at
+/// once times the A key-down callback; the key-up is untimed, then a 10 ms
+/// spin lets the helper go idle again.
+fn d_r16d_deferred_wake(count: usize) -> Vec<Duration> {
+    use crate::platform::timers::WaitableTimer;
+    bind_f13_to_do_nothing();
+    let (ready_tx, ready) = mpsc::channel();
+    let helper = thread::spawn(move || {
+        let mut msg = MSG::default();
+        // SAFETY: probe; `msg` is a local; makes this thread's queue.
+        let _ = unsafe { PeekMessageW(&mut msg, None, WM_USER, WM_USER, PM_NOREMOVE) };
+        let timer = WaitableTimer::new().expect("probe timer");
+        // SAFETY: probe; no arguments.
+        let _ = ready_tx.send(unsafe { GetCurrentThreadId() });
+        let mut ticking = false;
+        loop {
+            let mask = if ticking {
+                QS_ALLINPUT & !QS_POSTMESSAGE
+            } else {
+                QS_ALLINPUT
+            };
+            // SAFETY: probe; the handle lives in `timer`.
+            let woke = unsafe {
+                MsgWaitForMultipleObjectsEx(
+                    Some(&[timer.handle()]),
+                    windows::Win32::System::Threading::INFINITE,
+                    mask,
+                    MWMO_INPUTAVAILABLE,
+                )
+            };
+            if woke == WAIT_OBJECT_0 {
+                // SAFETY: probe; `msg` is a local of this thread.
+                while unsafe { PeekMessageW(&mut msg, None, 0, 0, PM_REMOVE) }.as_bool() {
+                    if msg.message == WM_QUIT {
+                        return;
+                    }
+                }
+                ticking = false;
+            } else {
+                std::hint::black_box(Instant::now());
+                let _ = timer.set(Duration::from_millis(5));
+                ticking = true;
+            }
+        }
+    });
+    let thread_id = ready.recv().expect("probe helper starts");
+    let mut samples = Vec::with_capacity(count);
+    for _ in 0..count {
+        // SAFETY: probe; posts to the helper's queue, no pointer.
+        let _ = unsafe { PostThreadMessageW(thread_id, WM_APP + 0x16, WPARAM(0), LPARAM(0)) };
+        let begun = Instant::now();
+        std::hint::black_box(call_keyboard_callback(VK_A, WM_KEYDOWN));
+        samples.push(begun.elapsed());
+        call_keyboard_callback(VK_A, WM_KEYUP);
+        spin_for(Duration::from_millis(10));
+    }
+    // SAFETY: probe; posts WM_QUIT to the helper.
+    let _ = unsafe { PostThreadMessageW(thread_id, WM_QUIT, WPARAM(0), LPARAM(0)) };
+    helper.join().expect("probe helper ends");
+    samples
+}
+
 /// The message R15 posts to its window.
 const R15_MESSAGE: u32 = WM_APP + 0x15;
 
