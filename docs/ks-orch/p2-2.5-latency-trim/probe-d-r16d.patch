+/// Lane 2.5 probe only (uncommitted): R12, R12m, R12m2, R17t and R17a alone,
+/// for repeated short runs.
+#[test]
+#[ignore = "probe"]
+fn probe_reads_only() {
+    let _alone = BENCH.lock().unwrap_or_else(PoisonError::into_inner);
+    let out = std::env::var_os("KS_BENCH_OUT").expect("KS_BENCH_OUT");
+    let label = std::env::var("KS_BENCH_LABEL").unwrap_or_else(|_| "unlabelled".to_owned());
+    let _main = MainThread::new().expect("main");
+    let rows = [
+        ("R12", r12_ordinary_key(2_000)),
+        ("R12m", r12m_key_down_with_injected_modifiers(&[VK_LCONTROL], 2_000)),
+        ("R12m2", r12m_key_down_with_injected_modifiers(&[VK_LCONTROL, VK_LSHIFT], 2_000)),
+        ("R17t", r17t_tick_count(2_000)),
+        ("R17a", r17a_async_key_state(2_000)),
+    ];
+    get_hook().update_bindings(Vec::new());
+    let mut table = format!("\n#### {label}\n\n| Row | n | mean us | p50 us | p99 us | max us |\n|---|---|---|---|---|---|\n");
+    for (id, samples) in &rows {
+        let _ = writeln!(table, "| {id} {}", summary(samples));
+    }
+    let mut file = std::fs::OpenOptions::new().create(true).append(true).open(&out).expect("open");
+    file.write_all(table.as_bytes()).expect("write");
+}
