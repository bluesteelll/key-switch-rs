+        .check_nothing_stuck()
+        .down("F13")
+        .expect_passed()
+        .expect_nothing_fired()
+        .advance_ms(200)
+        .expect_fired(&[BindAction::SwitchLanguage])
+        .advance_ms(300)
+        .repeat("F13")
+        .expect_passed()
+        .expect_nothing_fired()
+        .up("F13")
+        .expect_passed()
+        .expect_nothing_fired()
+        .down("F13")
